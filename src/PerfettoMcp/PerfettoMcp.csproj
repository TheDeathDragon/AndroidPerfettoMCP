<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PerfettoMcp</RootNamespace>
    <AssemblyName>perfetto-mcp</AssemblyName>
    <Version>0.7.0</Version>
    <!-- No libicu dependency on Ubuntu 18.04. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PerfettoMcp.Tests" />
    <EmbeddedResource Include="Resources\stdlib_index.tsv" LogicalName="stdlib_index.tsv" />
    <EmbeddedResource Include="..\..\configs\scenario.pbtxt" LogicalName="config.scenario.pbtxt" />
    <EmbeddedResource Include="..\..\configs\boottrace.pbtxt" LogicalName="config.boot.pbtxt" />
    <EmbeddedResource Include="..\..\configs\heap_dump.pbtxt" LogicalName="config.heap.pbtxt" />
    <EmbeddedResource Include="..\..\configs\idle.pbtxt" LogicalName="config.idle.pbtxt" />
  </ItemGroup>

  <!-- Ship the trace_processor_shell for the target RID next to the executable. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64' Or ('$(RuntimeIdentifier)' == '' And '$(OS)' != 'Windows_NT')">
    <None Include="..\..\tools\linux-x64\trace_processor_shell" Link="tools\trace_processor_shell" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64' Or ('$(RuntimeIdentifier)' == '' And '$(OS)' == 'Windows_NT')">
    <None Include="..\..\tools\win-x64\trace_processor_shell.exe" Link="tools\trace_processor_shell.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
